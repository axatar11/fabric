      "source": [
        "# --- Silver Okta match QA (run after transform; reads local merge staging) ---\nfrom pathlib import Path\n\n_staging = _purview_merge_staging_dir(TABLE_PURVIEW_COPILOT_SILVER)\nif not _staging.is_dir() or not any(_staging.glob(\"part-*.parquet\")):\n    raise FileNotFoundError(\n        f\"No silver staging at {_staging}. Run the transform cell first.\"\n    )\n\nprint(f\"purview silver QA: reading {_staging}\", flush=True)\n_qa = spark.read.parquet(str(_staging))\n_qa = _qa.cache()\n\n_leading10 = F.col(\"purview_copilot_usage_email\").rlike(r\"^10[^@]*@\")\n_has_okta = F.col(\"okta_user_id\").isNotNull()\n_primary_hit = _has_okta & (\n    (F.col(\"purview_copilot_usage_email\") == F.col(\"okta_user_email\"))\n    | (F.col(\"purview_copilot_usage_email\") == F.col(\"okta_user_full_email\"))\n)\n_fallback_hit = _has_okta & _leading10 & (\n    (F.col(\"purview_copilot_usage_email_fallback\") == F.col(\"okta_user_email\"))\n    | (F.col(\"purview_copilot_usage_email_fallback\") == F.col(\"okta_user_full_email\"))\n)\n\ndef _dcount(df, col):\n    return df.select(col).distinct().count()\n\n_metrics = {\n    \"silver_rows\": _qa.count(),\n    \"distinct_record_id\": _dcount(_qa, \"purview_copilot_usage_record_id\"),\n    \"distinct_purview_email\": _dcount(_qa, \"purview_copilot_usage_email\"),\n    \"distinct_okta_user_id (matched)\": _dcount(_qa.filter(_has_okta), \"okta_user_id\"),\n    \"distinct_okta_user_email (matched)\": _dcount(_qa.filter(_has_okta), \"okta_user_email\"),\n    \"rows_okta_null\": _qa.filter(~_has_okta).count(),\n    \"distinct_purview_email_okta_null\": _dcount(_qa.filter(~_has_okta), \"purview_copilot_usage_email\"),\n    \"leading_10_rows\": _qa.filter(_leading10).count(),\n    \"leading_10_distinct_purview_email\": _dcount(_qa.filter(_leading10), \"purview_copilot_usage_email\"),\n    \"leading_10_distinct_okta_user_id\": _dcount(_qa.filter(_leading10 & _has_okta), \"okta_user_id\"),\n    \"distinct_email_primary_okta_match\": _dcount(_qa.filter(_primary_hit), \"purview_copilot_usage_email\"),\n    \"distinct_email_fallback_okta_match (10-prefix heuristic)\": _dcount(\n        _qa.filter(_fallback_hit), \"purview_copilot_usage_email\"\n    ),\n}\n\nprint(\"\\n",
        "purview silver QA \u2014 expected ~31k distinct okta_user_id if primary + fallback both work\")\nprint(\"(target ballpark: ~20k primary + ~11k leading-10 fallback, not additive if overlap)\\n",
        "\")\nfor k, v in _metrics.items():\n    print(f\"  {k}: {v:,}\")\n\n# Overlap check: matched only via fallback heuristic (10-prefix, not primary string match)\n_only_fb = _qa.filter(_fallback_hit & ~_primary_hit)\nprint(\n    f\"\\n",
        "  distinct_email_10prefix_fallback_only (not primary string match): \"\n    f\"{_dcount(_only_fb, 'purview_copilot_usage_email'):,}\"\n)\n\nimport Common.transforms as _pt\nprint(f\"\\n",
        "  transforms module: {_pt.__file__}\")\nprint(f\"  uses join_okta_purview_with_fallback: {'join_okta_purview_with_fallback' in dir(_pt)}\")\n\n_qa.unpersist()\n\\n"
