    {
      "cell_type": "code",
      "metadata": {
        "name": "purview_local_csv_bronze"
      },
      "source": [
        "# --- Purview local CSV bronze (notebook only; does not use Common/io break_lineage) ---\n",
        "import json\n",
        "import os\n",
        "import shutil\n",
        "\n",
        "import pandas as pd\n",
        "import pyarrow as pa\n",
        "import pyarrow.parquet as pq\n",
        "\n",
        "_PURVIEW_CSV_EXPORT_COLUMNS = [\n",
        "    \"RecordId\",\n",
        "    \"CreationDate\",\n",
        "    \"RecordType\",\n",
        "    \"Operation\",\n",
        "    \"UserId\",\n",
        "    \"AuditData\",\n",
        "    \"AssociatedAdminUnits\",\n",
        "    \"AssociatedAdminUnitsNames\",\n",
        "]\n",
        "\n",
        "_PURVIEW_BRONZE_COLUMNS = [\n",
        "    \"AuditData\",\n",
        "    \"RecordId\",\n",
        "    \"CreationDate\",\n",
        "    \"FileName\",\n",
        "    \"ExecutionDate\",\n",
        "    \"UserId\",\n",
        "    \"RecordType\",\n",
        "    \"Operation\",\n",
        "    \"AssociatedAdminUnits\",\n",
        "    \"AssociatedAdminUnitsNames\",\n",
        "]\n",
        "\n",
        "\n",
        "def _purview_bronze_parquet_dir(label: str = \"purview_copilot_bronze\") -> Path:\n",
        "    return Path.home() / \".fabric\" / \"merge_staging\" / \"_break\" / label\n",
        "\n",
        "\n",
        "def _purview_merge_staging_dir(table_fqn: str) -> Path:\n",
        "    return Path.home() / \".fabric\" / \"merge_staging\" / table_fqn.replace(\".\", \"__\")\n",
        "\n",
        "\n",
        "def _purview_spark_is_alive(session) -> bool:\n",
        "    if session is None:\n",
        "        return False\n",
        "    try:\n",
        "        session.range(1).count()\n",
        "        return True\n",
        "    except Exception:\n",
        "        return False\n",
        "\n",
        "\n",
        "def _purview_recreate_spark():\n",
        "    \"\"\"Replace a dead Py4J session without a manual kernel restart.\"\"\"\n",
        "    global spark\n",
        "    from Common.bootstrap import _stop_active_spark, create_onelake_spark\n",
        "\n",
        "    print(\"purview: recreating Spark session (JVM was not responding)\u2026\", flush=True)\n",
        "    _stop_active_spark()\n",
        "    spark = create_onelake_spark(\"Medallion-Purview\")\n",
        "    ng = globals()\n",
        "    ng[\"spark\"] = spark\n",
        "    reload_io_helpers(ng)\n",
        "    apply_local_merge_spark_conf(spark)\n",
        "    spark.range(1).count()\n",
        "    print(f\"purview: Spark OK \u2014 {spark.version}\", flush=True)\n",
        "    return spark\n",
        "\n",
        "\n",
        "def _purview_ensure_spark_alive():\n",
        "    global spark\n",
        "    if _purview_spark_is_alive(spark):\n",
        "        return spark\n",
        "    return _purview_recreate_spark()\n",
        "\n",
        "\n",
        "def _purview_wipe_local_staging(table_fqn: str | None = None) -> None:\n",
        "    \"\"\"Drop stale Purview break/merge dirs from prior failed runs.\"\"\"\n",
        "    for label in (\"purview_copilot_bronze\", \"purview_copilot_silver\"):\n",
        "        path = _purview_bronze_parquet_dir(label)\n",
        "        if path.exists():\n",
        "            shutil.rmtree(path, ignore_errors=True)\n",
        "            print(f\"purview staging: removed {path}\", flush=True)\n",
        "    if table_fqn is None:\n",
        "        table_fqn = globals().get(\"TABLE_PURVIEW_COPILOT_SILVER\")\n",
        "    if table_fqn:\n",
        "        merge_path = _purview_merge_staging_dir(table_fqn)\n",
        "        if merge_path.exists():\n",
        "            shutil.rmtree(merge_path, ignore_errors=True)\n",
        "            print(f\"purview staging: removed {merge_path}\", flush=True)\n",
        "\n",
        "\n",
        "def _purview_normalize_csv_headers(df: pd.DataFrame) -> pd.DataFrame:\n",
        "    rename = {}\n",
        "    for col in df.columns:\n",
        "        key = col.strip().lower().replace(\"_\", \"\")\n",
        "        mapping = {\n",
        "            \"recordid\": \"RecordId\",\n",
        "            \"creationdate\": \"CreationDate\",\n",
        "            \"recordtype\": \"RecordType\",\n",
        "            \"operation\": \"Operation\",\n",
        "            \"userid\": \"UserId\",\n",
        "            \"auditdata\": \"AuditData\",\n",
        "            \"associatedadminunits\": \"AssociatedAdminUnits\",\n",
        "            \"associatedadminunitsnames\": \"AssociatedAdminUnitsNames\",\n",
        "        }\n",
        "        if key in mapping and col != mapping[key]:\n",
        "            rename[col] = mapping[key]\n",
        "    if rename:\n",
        "        df = df.rename(columns=rename)\n",
        "    missing = [c for c in _PURVIEW_CSV_EXPORT_COLUMNS if c not in df.columns]\n",
        "    if missing:\n",
        "        raise ValueError(f\"CSV missing columns {missing}; have {list(df.columns)}\")\n",
        "    return df\n",
        "\n",
        "\n",
        "def _purview_execution_date(audit: str | None) -> str | None:\n",
        "    if audit is None or (isinstance(audit, float) and pd.isna(audit)):\n",
        "        return None\n",
        "    try:\n",
        "        return json.loads(str(audit)).get(\"CreationTime\")\n",
        "    except (json.JSONDecodeError, TypeError):\n",
        "        return None\n",
        "\n",
        "\n",
        "def _purview_parse_creation_ts(series: pd.Series) -> pd.Series:\n",
        "    return pd.to_datetime(series.astype(str).str.strip(), utc=True, errors=\"coerce\")\n",
        "\n",
        "\n",
        "def _purview_chunk_to_bronze(df: pd.DataFrame, source_file: str) -> pd.DataFrame:\n",
        "    df = _purview_normalize_csv_headers(df)\n",
        "    out = pd.DataFrame()\n",
        "    out[\"AuditData\"] = df[\"AuditData\"].astype(str)\n",
        "    out[\"RecordId\"] = df[\"RecordId\"].astype(str).str.strip()\n",
        "    out[\"CreationDate\"] = df[\"CreationDate\"].astype(str).str.strip()\n",
        "    out[\"FileName\"] = source_file\n",
        "    out[\"ExecutionDate\"] = df[\"AuditData\"].map(_purview_execution_date)\n",
        "    out[\"UserId\"] = df[\"UserId\"].astype(str).str.strip()\n",
        "    out[\"RecordType\"] = df[\"RecordType\"].astype(str)\n",
        "    out[\"Operation\"] = df[\"Operation\"].astype(str)\n",
        "    out[\"AssociatedAdminUnits\"] = df[\"AssociatedAdminUnits\"].astype(str)\n",
        "    out[\"AssociatedAdminUnitsNames\"] = df[\"AssociatedAdminUnitsNames\"].astype(str)\n",
        "    return out[_PURVIEW_BRONZE_COLUMNS]\n",
        "\n",
        "\n",
        "def _purview_month_bounds(creation_month: str | None):\n",
        "    if not creation_month:\n",
        "        return None, None\n",
        "    start = pd.Timestamp(f\"{creation_month}-01\", tz=\"UTC\")\n",
        "    if start.month == 12:\n",
        "        end = pd.Timestamp(f\"{start.year + 1}-01-01\", tz=\"UTC\")\n",
        "    else:\n",
        "        end = pd.Timestamp(f\"{start.year}-{start.month + 1:02d}-01\", tz=\"UTC\")\n",
        "    return start, end\n",
        "\n",
        "\n",
        "def load_purview_bronze_from_local_csv(\n",
        "    csv_dir: Path,\n",
        "    *,\n",
        "    glob_pattern: str = \"*.csv\",\n",
        "    chunk_rows: int = 50_000,\n",
        "    creation_month: str | None = None,\n",
        "    filenames: list[str] | None = None,\n",
        "    break_label: str = \"purview_copilot_bronze\",\n",
        "):\n",
        "    \"\"\"Pandas chunked CSV \u2192 local parquet; Spark only reads file:// parquet at the end.\"\"\"\n",
        "    csv_dir = Path(csv_dir).expanduser().resolve()\n",
        "    files = sorted(csv_dir.glob(glob_pattern))\n",
        "    if filenames:\n",
        "        allow = set(filenames)\n",
        "        files = [p for p in files if p.name in allow]\n",
        "    if not files:\n",
        "        raise FileNotFoundError(f\"No CSV files under {csv_dir} ({glob_pattern})\")\n",
        "\n",
        "    out_dir = _purview_bronze_parquet_dir(break_label)\n",
        "    shutil.rmtree(out_dir, ignore_errors=True)\n",
        "    out_dir.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "    month_start, month_end = _purview_month_bounds(creation_month)\n",
        "    if month_start is not None:\n",
        "        print(f\"purview CSV load: CreationDate in {creation_month}\", flush=True)\n",
        "\n",
        "    print(f\"purview CSV load: {len(files)} file(s) \u2192 {out_dir}\", flush=True)\n",
        "    for p in files:\n",
        "        print(f\"  - {p.name}\", flush=True)\n",
        "\n",
        "    part_idx = 0\n",
        "    total_rows = 0\n",
        "    for csv_path in files:\n",
        "        reader = pd.read_csv(\n",
        "            csv_path,\n",
        "            chunksize=chunk_rows,\n",
        "            dtype=str,\n",
        "            keep_default_na=False,\n",
        "            encoding=\"utf-8-sig\",\n",
        "        )\n",
        "        for chunk in reader:\n",
        "            bronze_chunk = _purview_chunk_to_bronze(chunk, csv_path.name)\n",
        "            if month_start is not None:\n",
        "                ts = _purview_parse_creation_ts(bronze_chunk[\"CreationDate\"])\n",
        "                mask = (ts >= month_start) & (ts < month_end)\n",
        "                bronze_chunk = bronze_chunk.loc[mask]\n",
        "                if bronze_chunk.empty:\n",
        "                    continue\n",
        "            total_rows += len(bronze_chunk)\n",
        "            pq.write_table(\n",
        "                pa.Table.from_pandas(bronze_chunk, preserve_index=False),\n",
        "                out_dir / f\"part-{part_idx:05d}.parquet\",\n",
        "            )\n",
        "            part_idx += 1\n",
        "            if part_idx % 10 == 0:\n",
        "                print(f\"purview CSV load: {total_rows} rows written\u2026\", flush=True)\n",
        "\n",
        "    if part_idx == 0:\n",
        "        raise RuntimeError(\n",
        "            \"No rows written after CSV load (check PURVIEW_BRONZE_CREATION_MONTH / filenames).\"\n",
        "        )\n",
        "\n",
        "    print(f\"purview CSV load: done \u2014 {total_rows} rows, {part_idx} parquet part(s)\", flush=True)\n",
        "    return out_dir\n",
        "\n",
        "\n",
        "def purview_local_csv_silver_to_staging(\n",
        "    bronze_parquet_dir: Path,\n",
        "    okta,\n",
        "    hc,\n",
        "    *,\n",
        "    min_creation_date: str,\n",
        "    table_fqn: str,\n",
        ") -> Path:\n",
        "    \"\"\"Transform + stage silver one bronze parquet part at a time (avoids one huge JVM join).\"\"\"\n",
        "    import gc\n",
        "    from Common import io\n",
        "\n",
        "    bronze_parquet_dir = Path(bronze_parquet_dir)\n",
        "    part_files = sorted(bronze_parquet_dir.glob(\"part-*.parquet\"))\n",
        "    if not part_files:\n",
        "        raise FileNotFoundError(f\"No bronze parquet under {bronze_parquet_dir}\")\n",
        "\n",
        "    staging_path = _purview_merge_staging_dir(table_fqn)\n",
        "    shutil.rmtree(staging_path, ignore_errors=True)\n",
        "    staging_path.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "    collect_rows = max(\n",
        "        5_000, int(os.environ.get(\"MEDALLION_STAGING_COLLECT_ROWS\", \"15000\"))\n",
        "    )\n",
        "    print(\n",
        "        f\"purview silver: batched join {len(part_files)} bronze part(s) -> {staging_path} \"\n",
        "        f\"(collect_rows={collect_rows}, PyArrow)\",\n",
        "        flush=True,\n",
        "    )\n",
        "\n",
        "    _purview_ensure_spark_alive()\n",
        "    apply_local_merge_spark_conf(spark)\n",
        "    spark.conf.set(\"spark.sql.autoBroadcastJoinThreshold\", \"104857600\")\n",
        "    spark.conf.set(\"spark.sql.adaptive.autoBroadcastJoinThreshold\", \"104857600\")\n",
        "    okta = okta.cache()\n",
        "    hc = hc.cache()\n",
        "    okta.count()\n",
        "    hc.count()\n",
        "\n",
        "    global_part = 0\n",
        "    for batch_no, part_path in enumerate(part_files, start=1):\n",
        "        print(f\"purview silver batch {batch_no}/{len(part_files)}: {part_path.name}\", flush=True)\n",
        "        last_exc: BaseException | None = None\n",
        "        for attempt in range(2):\n",
        "            try:\n",
        "                _purview_ensure_spark_alive()\n",
        "                apply_local_merge_spark_conf(spark)\n",
        "                bronze_batch = spark.read.parquet(str(part_path))\n",
        "                write_df = build_purview_copilot_usage_silver(\n",
        "                    bronze_batch,\n",
        "                    okta,\n",
        "                    hc,\n",
        "                    min_creation_date=min_creation_date,\n",
        "                )\n",
        "                staged = io._sanitize_df_for_export(write_df)\n",
        "                tmp = staging_path / f\"_tmp_batch_{batch_no:05d}\"\n",
        "                io._write_df_via_local_iterator_chunks(staged, tmp)\n",
        "                written = 0\n",
        "                for chunk_file in sorted(tmp.glob(\"part-*.parquet\")):\n",
        "                    dest = staging_path / f\"part-{global_part + written:05d}.parquet\"\n",
        "                    chunk_file.replace(dest)\n",
        "                    written += 1\n",
        "                shutil.rmtree(tmp, ignore_errors=True)\n",
        "                global_part += written\n",
        "                last_exc = None\n",
        "                break\n",
        "            except BaseException as exc:\n",
        "                last_exc = exc\n",
        "                print(\n",
        "                    f\"  attempt {attempt + 1} failed ({type(exc).__name__})\",\n",
        "                    flush=True,\n",
        "                )\n",
        "                if not _purview_spark_is_alive(spark):\n",
        "                    _purview_recreate_spark()\n",
        "        if last_exc is not None:\n",
        "            raise RuntimeError(\n",
        "                f\"purview silver batch failed on {part_path.name}\"\n",
        "            ) from last_exc\n",
        "        gc.collect()\n",
        "\n",
        "    okta.unpersist()\n",
        "    hc.unpersist()\n",
        "    if global_part == 0:\n",
        "        raise RuntimeError(f\"No staging parquet written under {staging_path}\")\n",
        "    print(\n",
        "        f\"purview merge staging: done \u2014 {global_part} parquet part(s) -> {staging_path}\",\n",
        "        flush=True,\n",
        "    )\n",
        "    return staging_path\n",
        "\n",
        "\n",
        "def purview_publish_merge_staging_notebook(df, table_fqn: str) -> Path:\n",
        "    \"\"\"Write merge staging via chunked driver collect + PyArrow (avoids JVM parquet OOM).\"\"\"\n",
        "    from Common import io\n",
        "\n",
        "    path = _purview_merge_staging_dir(table_fqn)\n",
        "    parts = max(1, int(globals().get(\"PURVIEW_MERGE_STAGING_PARTITIONS\", 8)))\n",
        "    collect_rows = max(\n",
        "        5_000, int(os.environ.get(\"MEDALLION_STAGING_COLLECT_ROWS\", \"15000\"))\n",
        "    )\n",
        "    print(\n",
        "        f\"purview merge staging: {table_fqn} -> {path} \"\n",
        "        f\"(repartition={parts}, collect_rows={collect_rows}, PyArrow)\",\n",
        "        flush=True,\n",
        "    )\n",
        "    last_exc: BaseException | None = None\n",
        "    for attempt in range(2):\n",
        "        try:\n",
        "            _purview_ensure_spark_alive()\n",
        "            apply_local_merge_spark_conf(spark)\n",
        "            spark.conf.set(\"spark.sql.shuffle.partitions\", str(max(parts, 8)))\n",
        "            if path.exists():\n",
        "                shutil.rmtree(path, ignore_errors=True)\n",
        "            staged = io._sanitize_df_for_export(df)\n",
        "            if parts > 1:\n",
        "                staged = staged.repartition(parts)\n",
        "            io._write_df_via_local_iterator_chunks(staged, path)\n",
        "            if not any(path.glob(\"*.parquet\")):\n",
        "                raise RuntimeError(f\"No parquet files written under {path}\")\n",
        "            print(f\"purview merge staging: done -> {path}\", flush=True)\n",
        "            return path\n",
        "        except BaseException as exc:\n",
        "            last_exc = exc\n",
        "            print(\n",
        "                f\"purview merge staging: attempt {attempt + 1} failed ({type(exc).__name__})\",\n",
        "                flush=True,\n",
        "            )\n",
        "            if not _purview_spark_is_alive(spark):\n",
        "                _purview_recreate_spark()\n",
        "    raise RuntimeError(\n",
        "        f\"purview merge staging failed for {table_fqn} at {path}\"\n",
        "    ) from last_exc\n",
        ""
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "name": "read_purview_bronze"
      },
      "source": [
        "if PURVIEW_BRONZE_SOURCE == \"local_csv\":\n",
        "    _purview_wipe_local_staging()\n",
        "    _purview_ensure_spark_alive()\n",
        "    PURVIEW_BRONZE_PARQUET_DIR = load_purview_bronze_from_local_csv(\n",
        "        PURVIEW_BRONZE_CSV_DIR,\n",
        "        glob_pattern=PURVIEW_BRONZE_CSV_GLOB,\n",
        "        chunk_rows=PURVIEW_BRONZE_CSV_CHUNK_ROWS,\n",
        "        creation_month=PURVIEW_BRONZE_CREATION_MONTH,\n",
        "        filenames=PURVIEW_BRONZE_FILENAMES or None,\n",
        "    )\n",
        "elif PURVIEW_BRONZE_SOURCE == \"onelake\":\n",
        "    _purview_ensure_spark_alive()\n",
        "    bronze = read_table_broken_lineage(\n",
        "        TABLE_PURVIEW_COPILOT_BRONZE,\n",
        "        \"purview_copilot_bronze\",\n",
        "    )\n",
        "else:\n",
        "    raise ValueError(f\"Unknown PURVIEW_BRONZE_SOURCE: {PURVIEW_BRONZE_SOURCE!r}\")\n",
        ""
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "name": "read_okta_silver"
      },
      "source": [
        "_purview_ensure_spark_alive()\n",
        "okta = read_table_broken_lineage(TABLE_OKTA_SILVER, \"okta_silver\")\n",
        ""
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "name": "read_hc_silver"
      },
      "source": [
        "_purview_ensure_spark_alive()\n",
        "hc = read_table_broken_lineage(TABLE_HC_SILVER, \"hc_silver\")\n",
        ""
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "name": "transform_purview_silver"
      },
      "source": [
        "_purview_ensure_spark_alive()\n",
